{
	"name": "fuyao-admin-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"api:generate": "openapi-typescript ../../contracts/openapi/management.yaml -o src/lib/api/schema.d.ts",
		"api:check": "sh -c 'openapi-typescript ../../contracts/openapi/management.yaml -o src/lib/api/schema.generated.tmp.d.ts; status=$?; if [ $status -ne 0 ]; then rm -f src/lib/api/schema.generated.tmp.d.ts; exit $status; fi; diff src/lib/api/schema.d.ts src/lib/api/schema.generated.tmp.d.ts; diffstatus=$?; rm -f src/lib/api/schema.generated.tmp.d.ts; exit $diffstatus'",
		"api:lint": "redocly lint ../../contracts/openapi/management.yaml --format stylish"
	},
	"devDependencies": {
		"@redocly/cli": "^1.34.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"jsdom": "^29.1.1",
		"openapi-typescript": "^7.9.1",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@simplewebauthn/browser": "^13.2.0"
	}
}
