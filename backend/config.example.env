# Example environment for the Fuyao management backend (local development).
# Copy the values you need into your shell or service definition; do not put
# real credentials into this file or the repository.

# PostgreSQL DSN (required). Replace with your local development database.
FUYAO_ADMIN_DATABASE_URL='postgres://fuyao:change-me@127.0.0.1:5432/fuyao_admin?sslmode=disable'

# Loopback listen address only; non-loopback values abort startup.
FUYAO_ADMIN_ADDR='127.0.0.1:8787'

# WebAuthn relying party. Plain-HTTP origins are accepted on loopback hosts
# only; an https origin switches session cookies to Secure.
FUYAO_ADMIN_RP_ID='localhost'
FUYAO_ADMIN_RP_ORIGINS='http://localhost:5174'
FUYAO_ADMIN_RP_DISPLAY_NAME='Fuyao Admin'

# Lifetimes.
FUYAO_ADMIN_SESSION_TTL='12h'
FUYAO_ADMIN_CHALLENGE_TTL='5m'
FUYAO_ADMIN_PERMIT_TTL='10m'

# Theme contract schemas (optional). Path to contracts/theme in the
# repository. When set, theme-configuration saves are validated against each
# theme's own schema by schemas compiled at startup; when unset, saving a
# theme selection fails with 503 theme_contracts_unavailable.
# FUYAO_ADMIN_THEME_CONTRACTS='/path/to/FuyaoHomepage/contracts/theme'
