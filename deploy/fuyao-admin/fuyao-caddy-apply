#!/bin/sh
# Operator-controlled edge apply for fuyao-admin: validate the full Caddyfile
# (including the managed snippet), then reload Caddy. Fixed arguments only.
set -eu
test "$#" -eq 0 || exit 64
/usr/sbin/runuser -u caddy -- /usr/bin/caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null
exec /usr/sbin/runuser -u caddy -- /usr/bin/caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
