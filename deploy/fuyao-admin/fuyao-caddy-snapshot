#!/bin/bash
# Both executables and this wrapper are root-owned and service-immutable.
set -euo pipefail
[ "$#" -eq 0 ] || exit 64
if ! /usr/bin/env -i PATH=/usr/bin:/bin HOME=/var/lib/caddy \
    /usr/sbin/runuser -u caddy -- /usr/bin/caddy adapt \
    --config /etc/caddy/Caddyfile --adapter caddyfile 2>/dev/null \
    | /usr/bin/env -i PATH=/usr/bin:/bin \
        /usr/local/libexec/fuyao-caddy-inventory 2>/dev/null; then
    printf '%s\n' 'Caddy inventory unavailable' >&2
    exit 1
fi
