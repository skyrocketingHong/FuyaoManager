# FuyaoManager public entrance (manager.fuyaoskyrocket.ing).
#
# Install: copy to a directory imported by the main Caddyfile but OUTSIDE the
# platform-managed snippet directory (/etc/caddy/fuyao-admin/fuyao-admin.caddy
# is fully re-rendered by the backend; anything written there is lost), e.g.
#   /etc/caddy/fuyao-admin-manager/manager.public.caddy
# and add `import /etc/caddy/fuyao-admin-manager/*.caddy` to /etc/caddy/Caddyfile.
#
# The public vhost serves ONLY the standalone static page. The management
# API, the console bundle, and private previews are never proxied here;
# unknown API paths get an explicit 404, not a 200 HTML page.

(fuyao_manager_public_static) {
	# Share the existing public listener. The public IPv4 is NAT-mapped,
	# so it cannot be used as a local bind address. The separate private
	# vhost must explicitly bind its private interface before proxying.

	# Automatic HTTPS (public ACME). The same certificate also serves the
	# private-network vhost for this exact hostname.

	root * /srv/fuyao-admin/static-page

	# Management surface stays closed on the public network.
	@api path /api /api/* /assets /assets/*
	handle @api {
		respond 404
	}
	@previews path /preview /preview/* /_preview /_preview/*
	handle @previews {
		respond 404
	}

	handle {
		# Static files only; no SPA fallback, no index rewrite beyond
		# file_server's own directory index behavior.
		file_server
	}

	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

manager.fuyaoskyrocket.ing {
	import fuyao_manager_public_static
	encode gzip
}

# Direct public-IP HTTP requests receive the same static page. Other
# hostnames on this listener retain their own routes and HTTPS redirects.
http://149.129.75.59, http://[2001:470:35:2d8::2] {
	import fuyao_manager_public_static
}
