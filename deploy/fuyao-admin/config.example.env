# fuyao-admin runtime configuration template (matches the live deployment).
# FUYAO_ADMIN_DATABASE_URL lives in a separate db.env (mode 600) and is
# loaded as a second EnvironmentFile; never commit a real DSN.
FUYAO_ADMIN_ADDR=100.117.154.115:8787
FUYAO_ADMIN_TRUSTED_HOSTS=100.117.154.115
FUYAO_ADMIN_RP_ID=100.117.154.115
FUYAO_ADMIN_RP_ORIGINS=http://100.117.154.115:8787
FUYAO_ADMIN_SESSION_TTL=12h
FUYAO_ADMIN_AUTH_CODE_TTL=10m
FUYAO_ADMIN_THEME_CONTRACTS=/srv/fuyao-admin/current/theme/contracts/theme
FUYAO_ADMIN_REPO_ROOT=/srv/fuyao-admin/current/theme
FUYAO_ADMIN_SITES_ROOT=/srv/fuyao-admin/data/sites
FUYAO_ADMIN_BUILDS_ROOT=/srv/fuyao-admin/data/builds
FUYAO_ADMIN_RELEASES_ROOT=/srv/fuyao-admin/data/releases
FUYAO_ADMIN_UI_DIR=/srv/fuyao-admin/current/frontend
FUYAO_ADMIN_BUILD_MODE=ci
FUYAO_ADMIN_PREVIEW_BIND=100.117.154.115
FUYAO_ADMIN_PREVIEW_EXTERNAL_BASE=http://100.117.154.115
