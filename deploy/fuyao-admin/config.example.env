# fuyao-admin runtime configuration template (production, HTTPS domain
# topology). FUYAO_ADMIN_DATABASE_URL lives in a separate db.env (mode 600)
# loaded as a second EnvironmentFile; never commit a real DSN.
#
# Topology: browsers reach https://manager.fuyaoskyrocket.ing through Caddy,
# which terminates TLS and reverse-proxies to the loopback listener below.
# The public network vhost serves only the standalone static page; the
# private-network vhost (operator-maintained, outside the managed snippet)
# reaches the console. The passkey relying party is the domain itself — do
# not widen it to the parent domain, and do not mix localhost development
# origins into this file (development uses backend/config.example.env).
FUYAO_ADMIN_ADDR=127.0.0.1:8787
FUYAO_ADMIN_TRUSTED_HOSTS=manager.fuyaoskyrocket.ing
FUYAO_ADMIN_RP_ID=manager.fuyaoskyrocket.ing
FUYAO_ADMIN_RP_ORIGINS=https://manager.fuyaoskyrocket.ing
FUYAO_ADMIN_SESSION_TTL=12h
FUYAO_ADMIN_AUTH_CODE_TTL=10m
FUYAO_ADMIN_REGISTRATION_SESSION_TTL=30m
FUYAO_ADMIN_REPO_ROOT=/srv/fuyao-admin/current
FUYAO_ADMIN_THEME_CONTRACTS=/srv/fuyao-admin/current/contracts/theme
FUYAO_ADMIN_SITES_ROOT=/srv/fuyao-admin/data/sites
FUYAO_ADMIN_BUILDS_ROOT=/srv/fuyao-admin/data/builds
FUYAO_ADMIN_RELEASES_ROOT=/srv/fuyao-admin/data/releases
FUYAO_ADMIN_UI_DIR=/srv/fuyao-admin/current/frontend
FUYAO_ADMIN_BUILD_MODE=ci
# Private bind addresses and preview URLs are supplied by operator-local
# configuration, not this public template. Keep their existing values
# during an upgrade; the management domain is not a blanket replacement.
# FUYAO_ADMIN_PREVIEW_BIND=<private-interface-address>
# FUYAO_ADMIN_PREVIEW_EXTERNAL_BASE=http://<private-interface-address>
FUYAO_ADMIN_EDGE_SNIPPET_DIR=/etc/caddy/fuyao-admin
# Deployment switch (default off): keep false until the edge topology is
# verified; enabling starts the publish server and lets the platform
# reconcile and apply the managed Caddy snippet.
# FUYAO_ADMIN_DEPLOYMENT_ENABLED=false
# Optional registered static-site source control, separate from theme publishing.
# FUYAO_ADMIN_CADDY_CONTROL_CMD=/usr/bin/sudo,-n,/usr/local/sbin/fuyao-caddy-control
# FUYAO_ADMIN_CADDY_MANAGEMENT_ENABLED=false
# FUYAO_ADMIN_PLATFORM_CONTENT_ROOT=/srv/fuyao-admin/data/platform-content
# FUYAO_ADMIN_PLATFORM_MEDIA_THEME_ROW_ID=<registered-theme-row-uuid>
# FUYAO_ADMIN_TRAFFIC_STATS_URL=http://127.0.0.1:3191/api/stats/cloudflare
# FUYAO_ADMIN_TRAFFIC_STATS_SITE_ID=<managed-site-uuid>
# FUYAO_ADMIN_EDGE_PRIVATE_BIND=<private-interface-address>
FUYAO_ADMIN_EDGE_PUBLIC_HOST=149.129.75.59
FUYAO_ADMIN_PORT_MIN=20000
FUYAO_ADMIN_PORT_MAX=20100
